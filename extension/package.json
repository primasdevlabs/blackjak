{
  "name": "agent-vscode-extension",
  "displayName": "BlackJak AI Coding Agent",
  "description": "Local coding agent with settings, modes, and multi-agent workflows",
  "version": "1.0.0",
  "publisher": "primasdevlabs",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Programming Languages",
    "Other"
  ],
  "main": "./out/extension.js",
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "agent.open",
        "title": "Agent: Open"
      },
      {
        "command": "agent.newTask",
        "title": "Agent: New Task"
      },
      {
        "command": "agent.planTask",
        "title": "Agent: Plan Task"
      },
      {
        "command": "agent.cancelTask",
        "title": "Agent: Cancel Task"
      },
      {
        "command": "agent.restart",
        "title": "Agent: Restart Agent"
      },
      {
        "command": "agent.openSettings",
        "title": "Agent: Open Settings"
      },
      {
        "command": "agent.openActivity",
        "title": "Agent: Open Activity"
      },
      {
        "command": "agent.showLogs",
        "title": "Agent: Show Agent Logs"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agent-container",
          "title": "BlackJak Agent",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "agent-container": [
        {
          "type": "webview",
          "id": "agent.sidebar",
          "name": "BlackJak Agent",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "configuration": {
      "title": "BlackJak Agent",
      "properties": {
        "blackjak.autoOpenNewFiles": {
          "type": "boolean",
          "default": true,
          "description": "Automatically open newly created files in the editor."
        },
        "blackjak.autoRevealInExplorer": {
          "type": "boolean",
          "default": true,
          "description": "Automatically reveal created files in the file explorer."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build": "tsc -p ./"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/vscode": "^1.85.0",
    "@types/ws": "^8.5.10",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "ws": "^8.16.0"
  }
}
