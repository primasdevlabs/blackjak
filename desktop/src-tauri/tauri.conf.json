{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BlackJak",
  "version": "1.0.0",
  "identifier": "com.blackjak.desktop",
  "build": {
    "frontendDist": "../../extension/webview/react/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "cd ../.. && make ui",
    "beforeBuildCommand": "cd ../.. && make build-ui"
  },
  "app": {
    "windows": [
      {
        "title": "BlackJak",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.ico",
      "icons/icon.svg"
    ],
    "resources": ["../../bin/agent*"]
  }
}
